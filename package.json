    "build": "vite build",
    "preview": "vite preview",
    "netlify:dev": "netlify dev"
  },
  "dependencies": {
    "@line/liff": "^2.24.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "6.2.4",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.4.0"
  }
}
