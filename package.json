{
  "name": "cobras-ob",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite --host",
    "emulators": "firebase emulators:start --project demo-cobras",
    "emulators:keep": "firebase emulators:start --project demo-cobras --import=./emulator-data --export-on-exit",
    "seed": "node scripts/seed.mjs --emulator",
